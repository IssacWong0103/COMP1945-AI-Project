# Required for wardrobe uploads: garment tagging and strict single-item/non-clothing screening (VLM)
DEEPSEEK_API_KEY=
# kie.ai key for gpt-image-2-image-to-image virtual try-on
KIE_API_KEY=
# Public origin kie.ai can fetch images from (e.g. https://your-app.ngrok-free.app).
# Optional: when empty, the backend uploads local images to kie.ai's File Upload
# API so virtual try-on still works without a public tunnel.
PUBLIC_BASE_URL=
